# Application environment: development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO

# TiDB Cloud / MySQL 8 connection (dbptit — 13 ERD tables)
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=dbptit
TIDB_USER=your_db_user
TIDB_PASSWORD=your_db_password
TIDB_POOL_SIZE=8
# Optional path to CA certificate bundle for TiDB Cloud TLS verification
TIDB_SSL_CA=
TIDB_SSL_VERIFY_IDENTITY=true
TIDB_READ_TIMEOUT=30
TIDB_WRITE_TIMEOUT=30

# CORS & Trusted Reverse Proxies
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Comma-separated proxy IPs allowed to supply X-Forwarded-For (leave empty to always use socket peer IP)
TRUSTED_PROXY_IPS=

# Operations & Display
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# VietQR (EMVCo/NAPAS) bank configuration for Gate POS transfers
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=SMART PARKING PTIT

# Optional multi-worker WebSocket scaling
REDIS_URL=
WS_MAX_CONNECTIONS=500
