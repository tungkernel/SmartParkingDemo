# Application environment: development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO

# TiDB Cloud / MySQL 8 connection
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=dbptit
TIDB_USER=your_db_user
TIDB_PASSWORD=your_db_password
TIDB_POOL_SIZE=8
# Path to CA certificate bundle for TiDB Cloud TLS verification
TIDB_SSL_CA=
TIDB_SSL_VERIFY_IDENTITY=true
TIDB_READ_TIMEOUT=30
TIDB_WRITE_TIMEOUT=30

# Security & JWT (REQUIRED in production, >= 32 random characters)
AUTH_SECRET_KEY=replace-with-a-strong-random-secret-key-at-least-32-chars
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=604800
# Optional initial seed password when taikhoan table is empty (disabled in production unless set)
AUTH_DEFAULT_SEED_PASSWORD=

# CORS, Rate Limiting & Trusted Reverse Proxies
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated proxy IPs allowed to supply X-Forwarded-For (leave empty to always use socket peer IP)
TRUSTED_PROXY_IPS=

# VietQR (EMVCo/NAPAS) bank configuration for Gate POS transfers
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=SMART PARKING PTIT

# Optional multi-worker WebSocket scaling & legacy Streamlit write guard
REDIS_URL=
WS_MAX_CONNECTIONS=500
ENABLE_LEGACY_STREAMLIT_WRITES=false
